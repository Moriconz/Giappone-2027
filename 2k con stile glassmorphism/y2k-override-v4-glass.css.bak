/* ═══════════════════════════════════════════════════════════════════
   FONT IMPORTS — forziamo font Y2K coerenti su tutti i dispositivi
   (iOS, Android, Windows, Mac, Linux — nessuno ha più Comic Sans MS
    di default, quindi carichiamo Comic Neue + VT323 da Google Fonts)
═══════════════════════════════════════════════════════════════════ */
@import url('https://fonts.googleapis.com/css2?family=Comic+Neue:wght@400;700&family=VT323&family=Share+Tech+Mono&display=swap');

/* ═══════════════════════════════════════════════════════════════════
   Y2K × GLASSMORPHISM — Giappone 2027  ·  v4

   Sistema:
     · Stile base: FROSTED Y2K BUBBLE (glass + neon pink)
     · Stati speciali: HOLOGRAPHIC (bordo iridescente animato)
     · Cromature occasionali per accent metallici

   Palette:
     --neon-pink   #FF1493
     --neon-cyan   #00D4FF
     --neon-green  #00FF88
     --neon-gold   #FFD700
     --violet      #9D4EDD
     --ink         #0F0A30   sfondo profondo
     --ink-2       #1a1240   sfondo medio
═══════════════════════════════════════════════════════════════════ */

:root {
  --neon-pink:  #FF1493;
  --neon-cyan:  #00D4FF;
  --neon-green: #00FF88;
  --neon-gold:  #FFD700;
  --violet:     #9D4EDD;
  --ink:        #0F0A30;
  --ink-2:      #1a1240;
  --ink-3:      #2a1d6a;
  --glass-bg:        rgba(255, 255, 255, 0.10);
  --glass-bg-strong: rgba(255, 255, 255, 0.16);
  --glass-bg-dark:   rgba(20, 15, 50, 0.55);
  --glass-border:    rgba(255, 255, 255, 0.25);
  --glass-border-pink: rgba(255, 20, 147, 0.55);
  --glow-pink:  0 0 20px rgba(255, 20, 147, 0.45);
  --glow-cyan:  0 0 18px rgba(0, 212, 255, 0.40);
  --glow-green: 0 0 16px rgba(0, 255, 136, 0.40);
  --inset-top:  inset 0 1px 0 rgba(255, 255, 255, 0.45);
  --backdrop:   blur(22px) saturate(170%);
}

/* ── BODY: sfondo vivo che fa "vedere" il vetro ───────────────── */
/* TEST 6: Comment out aggressive universal :not() selector
html, body, *:not(#map):not(#map *):not(canvas):not(.ol-viewport):not(.ol-viewport *):not(.leaflet-container):not(.leaflet-container *) {
  /* Forza il monospace Y2K dappertutto come default
     ESCLUSI: la mappa e i suoi figli (OpenLayers/Leaflet usano canvas
     e classi interne — toccarli rompe il rendering). */
  font-family: 'Share Tech Mono', 'VT323', 'Courier New', 'Courier', monospace !important;
}
*/

/* La mappa deve restare assolutamente intatta + visibile sopra lo sfondo */
/* TEST 5: Comment out entire #map block to see if map appears
#map {
  background: #0a0820 !important;
  z-index: 1 !important;
  position: relative !important;
  transition: filter 0.3s ease !important;
}
#map.blur { filter: blur(8px) brightness(0.7) !important; }
#map canvas, #map .ol-viewport, #map .ol-layer { display: block !important; }
*/
html, body {
  color: #fff !important;
}

/* TEST 7: COMMENT ALL CSS RULES FROM HERE TO END (except variables/imports)
   If map appears, problem is in one of these CSS rules below.
   ═══════════════════════════════════════════════════════════════ */
/*

/* ── TITOLI / ELEMENTI Y2K "GIOCOSI" → Comic Neue ────────────────
   Comic Neue è il sostituto open-source di Comic Sans, identico
   come vibe ma disponibile su qualsiasi dispositivo via Google Fonts.
═════════════════════════════════════════════════════════════════ */
header h1,
header h1 .badge,
.chip,
nav.bottom button,
.sheet-header h2,
.win-header h2,
.section h3,
.btn,
.ai-welcome-title,
.ai-quick-chip,
.ai-itinerary-day h4,
.ai-send,
.groq-analyze-btn,
.gf-place-form .form-actions button,
.popup-btn,
#toast-container,
.y2k-win-title span,
.y2k-win-body .section h3,
.y2k-win-body .btn {
  font-family: 'Comic Neue', 'Comic Sans MS', 'Chalkboard SE', cursive !important;
  font-weight: 700 !important;
}

/* ── Input/textarea: monospace ma più leggibile ─────────────────── */
input, textarea, select, button {
  font-family: 'Share Tech Mono', 'Courier New', monospace !important;
}
body {
  background:
    radial-gradient(circle at 15% 20%, rgba(255,20,147,0.50) 0%, transparent 38%) !important,
    radial-gradient(circle at 85% 25%, rgba(0,212,255,0.45) 0%, transparent 42%) !important,
    radial-gradient(circle at 50% 85%, rgba(255,215,0,0.35) 0%, transparent 35%) !important,
    radial-gradient(circle at 25% 95%, rgba(157,78,221,0.45) 0%, transparent 40%) !important,
    linear-gradient(135deg, #1a1240 0%, #0f0a30 100%) !important;
  background-attachment: fixed !important;
}

/* ══════════════════════════════════════════════════════════════════
   HEADER — glass con bordo neon
══════════════════════════════════════════════════════════════════ */
header {
  position: relative !important;
  z-index: 200 !important;
  display: flex !important;
  align-items: center !important;
  gap: 10px !important;
  padding: 10px 14px !important;
  height: 52px !important;
  background: var(--glass-bg-dark) !important;
  backdrop-filter: var(--backdrop) !important;
  -webkit-backdrop-filter: var(--backdrop) !important;
  border: none !important;
  border-bottom: 1.5px solid var(--glass-border-pink) !important;
  box-shadow:
    0 4px 24px rgba(255, 20, 147, 0.20),
    var(--inset-top) !important;
}

header h1 {
  flex: 1 !important;
  display: flex !important;
  align-items: center !important;
  gap: 8px !important;
  margin: 0 !important;
  color: #fff !important;
  font-family: 'Comic Sans MS', cursive !important;
  font-weight: 700 !important;
  font-size: 17px !important;
  text-shadow: 0 0 14px rgba(255, 20, 147, 0.6), 0 0 24px rgba(255, 215, 0, 0.3) !important;
  letter-spacing: -0.3px !important;
}

header h1 .badge {
  display: inline-flex !important;
  align-items: center !important;
  background: linear-gradient(135deg, var(--neon-pink), #FF69B4) !important;
  color: #fff !important;
  border: 1px solid rgba(255, 255, 255, 0.45) !important;
  border-radius: 6px !important;
  font-size: 10px !important;
  font-weight: 700 !important;
  padding: 2px 7px !important;
  box-shadow: var(--glow-pink), var(--inset-top) !important;
  text-shadow: none !important;
}

.icon-btn {
  width: 36px !important;
  height: 36px !important;
  background: var(--glass-bg-strong) !important;
  backdrop-filter: blur(10px) !important;
  -webkit-backdrop-filter: blur(10px) !important;
  border: 1.5px solid var(--glass-border-pink) !important;
  border-radius: 50% !important;
  color: #fff !important;
  font-size: 16px !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  cursor: pointer !important;
  box-shadow:
    0 4px 14px rgba(255, 20, 147, 0.30),
    var(--inset-top) !important;
  transition: transform 0.18s ease, box-shadow 0.18s ease !important;
}
.icon-btn:hover  { transform: scale(1.08) !important; box-shadow: 0 6px 20px rgba(255,20,147,0.45), var(--inset-top) !important; }
.icon-btn:active { transform: scale(0.94) !important; }

/* ══════════════════════════════════════════════════════════════════
   FILTER BAR — chip glass fluttuanti, container trasparente
══════════════════════════════════════════════════════════════════ */
#filters {
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  backdrop-filter: none !important;
  padding: 10px 12px 6px !important;
  display: flex !important;
  flex-wrap: nowrap !important;
  overflow-x: auto !important;
  overflow-y: visible !important;
  gap: 7px !important;
  -webkit-overflow-scrolling: touch !important;
  scrollbar-width: none !important;
}
#filters::-webkit-scrollbar { display: none !important; }

.chip {
  flex-shrink: 0 !important;
  padding: 7px 14px !important;
  border-radius: 999px !important;
  background: var(--glass-bg-strong) !important;
  backdrop-filter: blur(14px) saturate(160%) !important;
  -webkit-backdrop-filter: blur(14px) saturate(160%) !important;
  border: 1.5px solid var(--glass-border-pink) !important;
  color: #fff !important;
  font-size: 12px !important;
  font-weight: 700 !important;
  font-family: 'Comic Sans MS', cursive !important;
  white-space: nowrap !important;
  text-shadow: 0 1px 2px rgba(0,0,0,0.4) !important;
  box-shadow:
    0 4px 14px rgba(255, 20, 147, 0.25),
    var(--inset-top) !important;
  transition: all 0.2s cubic-bezier(0.34,1.56,0.64,1) !important;
  cursor: pointer !important;
}
.chip:hover {
  transform: translateY(-2px) !important;
  box-shadow: 0 6px 18px rgba(255, 20, 147, 0.4), var(--inset-top) !important;
}
.chip.active {
  background: linear-gradient(135deg, rgba(255,20,147,0.85), rgba(157,78,221,0.85)) !important;
  border-color: var(--neon-green) !important;
  color: #fff !important;
  box-shadow: var(--glow-pink), var(--glow-green), var(--inset-top) !important;
}
.chip.gf {
  background: rgba(0, 255, 136, 0.18) !important;
  border-color: var(--neon-green) !important;
}
.chip.gf.active {
  background: linear-gradient(135deg, rgba(0,255,136,0.85), rgba(0,212,255,0.7)) !important;
  color: #0F0A30 !important;
  text-shadow: none !important;
}

/* ══════════════════════════════════════════════════════════════════
   BOTTOM NAV — glass scuro con bordo cyan/pink
══════════════════════════════════════════════════════════════════ */
nav.bottom {
  background: var(--glass-bg-dark) !important;
  backdrop-filter: var(--backdrop) !important;
  -webkit-backdrop-filter: var(--backdrop) !important;
  border-top: 1.5px solid rgba(0, 212, 255, 0.45) !important;
  box-shadow:
    0 -6px 28px rgba(0, 212, 255, 0.18),
    var(--inset-top) !important;
  padding: 6px 4px calc(6px + var(--safe-bottom, 0px)) !important;
  display: flex !important;
  gap: 3px !important;
}

nav.bottom button {
  flex: 1 !important;
  background: rgba(255, 255, 255, 0.06) !important;
  border: 1px solid rgba(255, 255, 255, 0.15) !important;
  border-radius: 9px !important;
  color: rgba(255, 255, 255, 0.85) !important;
  font-size: 9px !important;
  font-weight: 700 !important;
  font-family: 'Comic Sans MS', cursive !important;
  padding: 6px 2px 5px !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  gap: 3px !important;
  cursor: pointer !important;
  transition: all 0.18s ease !important;
  position: relative !important;
  text-shadow: 0 1px 2px rgba(0,0,0,0.4) !important;
}
nav.bottom button svg {
  width: 20px !important;
  height: 20px !important;
  stroke: currentColor !important;
  fill: none !important;
}
nav.bottom button:hover {
  background: rgba(255, 255, 255, 0.12) !important;
  color: #fff !important;
  transform: translateY(-1px) !important;
}
nav.bottom button.active {
  background: linear-gradient(135deg, rgba(255,20,147,0.85), rgba(157,78,221,0.85)) !important;
  border-color: var(--neon-green) !important;
  color: #fff !important;
  box-shadow: var(--glow-pink), var(--inset-top) !important;
}

/* ══════════════════════════════════════════════════════════════════
   SHEET / FINESTRE — glass scuro frosted
══════════════════════════════════════════════════════════════════ */
.sheet {
  background: rgba(15, 10, 48, 0.5) !important;
  backdrop-filter: blur(8px) !important;
  -webkit-backdrop-filter: blur(8px) !important;
}

.sheet-inner {
  background: var(--glass-bg-dark) !important;
  backdrop-filter: var(--backdrop) !important;
  -webkit-backdrop-filter: var(--backdrop) !important;
  border: 1.5px solid var(--glass-border) !important;
  border-top: 2px solid var(--glass-border-pink) !important;
  border-radius: 22px 22px 0 0 !important;
  box-shadow:
    0 -10px 50px rgba(255, 20, 147, 0.30),
    var(--inset-top) !important;
  color: #fff !important;
  padding-bottom: calc(20px + var(--safe-bottom, 0px)) !important;
}

.sheet-handle {
  background: var(--neon-pink) !important;
  width: 46px !important;
  height: 5px !important;
  border-radius: 3px !important;
  margin: 10px auto 0 !important;
  box-shadow: 0 0 12px var(--neon-pink) !important;
}

.sheet-header {
  padding: 14px 20px !important;
  background: transparent !important;
  border-bottom: 1px solid rgba(255, 20, 147, 0.30) !important;
  display: flex !important;
  align-items: center !important;
  gap: 10px !important;
}
.sheet-header h2 {
  margin: 0 !important;
  flex: 1 !important;
  color: #fff !important;
  font-family: 'Comic Sans MS', cursive !important;
  font-weight: 700 !important;
  font-size: 17px !important;
  text-shadow: 0 0 12px rgba(255, 20, 147, 0.5) !important;
}
.sheet-header .icon-btn {
  background: linear-gradient(135deg, var(--neon-pink), #FF69B4) !important;
  border-color: var(--neon-green) !important;
}

.sheet-body {
  padding: 18px 20px !important;
  color: #fff !important;
}

/* Tutti i testi nel pannello: bianco ad alto contrasto */
.sheet-inner *:not(button):not(.tag.cat):not(.tag.gf-full):not(.tag.gf-partial):not(.chip.active):not(.btn.primary):not(.btn.success):not(.ai-msg.user):not(.booking-date-badge):not(.item-tag):not(.gpc-tag):not(.nav-badge):not(.bc-status) {
  color: #fff !important;
}
.sheet-inner h2, .sheet-inner h3, .sheet-inner h4 {
  text-shadow: 0 1px 8px rgba(0,0,0,0.4) !important;
}

/* Sezioni */
.sheet-inner .section {
  margin: 18px 0 !important;
}
.sheet-inner .section h3 {
  color: var(--neon-cyan) !important;
  font-family: 'Comic Sans MS', cursive !important;
  font-size: 12px !important;
  font-weight: 700 !important;
  text-transform: uppercase !important;
  letter-spacing: 0.10em !important;
  margin: 0 0 10px !important;
  text-shadow: 0 0 10px rgba(0, 212, 255, 0.5) !important;
}
.sheet-inner .section p {
  font-size: 14px !important;
  line-height: 1.6 !important;
  margin: 0 0 8px !important;
  color: rgba(255,255,255,0.92) !important;
}

/* ══════════════════════════════════════════════════════════════════
   POI ROW — glass bubble
══════════════════════════════════════════════════════════════════ */
.poi-row {
  background: var(--glass-bg-strong) !important;
  backdrop-filter: blur(10px) !important;
  -webkit-backdrop-filter: blur(10px) !important;
  border: 1.5px solid var(--glass-border) !important;
  border-radius: 12px !important;
  padding: 12px 14px !important;
  margin-bottom: 8px !important;
  display: flex !important;
  align-items: center !important;
  gap: 10px !important;
  box-shadow: var(--inset-top) !important;
  transition: all 0.18s ease !important;
  cursor: pointer !important;
}
.poi-row:hover {
  background: rgba(255, 255, 255, 0.18) !important;
  border-color: var(--glass-border-pink) !important;
  transform: translateX(3px) !important;
  box-shadow: 0 4px 18px rgba(255, 20, 147, 0.25), var(--inset-top) !important;
}
.poi-row .icon {
  width: 36px !important;
  height: 36px !important;
  border-radius: 11px !important;
  background: linear-gradient(135deg, var(--neon-pink), #FF69B4) !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  font-size: 17px !important;
  flex-shrink: 0 !important;
  box-shadow: var(--glow-pink), var(--inset-top) !important;
}
.poi-row .name {
  color: #fff !important;
  font-family: 'Courier New', monospace !important;
  font-weight: 700 !important;
  font-size: 14px !important;
}
.poi-row .sub {
  color: rgba(255, 255, 255, 0.65) !important;
  font-size: 12px !important;
}

/* ══════════════════════════════════════════════════════════════════
   TAGS
══════════════════════════════════════════════════════════════════ */
.tag {
  background: var(--glass-bg-strong) !important;
  backdrop-filter: blur(8px) !important;
  border: 1px solid var(--glass-border) !important;
  border-radius: 6px !important;
  color: #fff !important;
  font-size: 11px !important;
  font-weight: 600 !important;
  padding: 3px 8px !important;
}
.tag.cat {
  background: linear-gradient(135deg, var(--neon-pink), #FF69B4) !important;
  border-color: rgba(255, 20, 147, 0.7) !important;
  color: #fff !important;
  box-shadow: var(--glow-pink) !important;
}
.tag.gf-full {
  background: linear-gradient(135deg, rgba(0,255,136,0.85), rgba(0,212,255,0.7)) !important;
  border-color: var(--neon-green) !important;
  color: #0F0A30 !important;
  box-shadow: var(--glow-green) !important;
}
.tag.gf-partial {
  background: linear-gradient(135deg, var(--neon-gold), #FFB800) !important;
  border-color: var(--neon-gold) !important;
  color: #0F0A30 !important;
}
.tag.gf-none {
  background: rgba(255, 255, 255, 0.08) !important;
  color: rgba(255, 255, 255, 0.7) !important;
}

/* ══════════════════════════════════════════════════════════════════
   BUTTONS
══════════════════════════════════════════════════════════════════ */
.btn {
  padding: 11px 18px !important;
  background: var(--glass-bg-strong) !important;
  backdrop-filter: blur(10px) !important;
  -webkit-backdrop-filter: blur(10px) !important;
  border: 1.5px solid var(--glass-border) !important;
  border-radius: 12px !important;
  color: #fff !important;
  font-family: 'Comic Sans MS', cursive !important;
  font-weight: 700 !important;
  font-size: 13px !important;
  text-shadow: 0 1px 2px rgba(0,0,0,0.4) !important;
  cursor: pointer !important;
  transition: all 0.18s ease !important;
  box-shadow: var(--inset-top) !important;
}
.btn:hover {
  background: rgba(255, 255, 255, 0.20) !important;
  transform: translateY(-2px) !important;
  box-shadow: 0 6px 18px rgba(0,0,0,0.3), var(--inset-top) !important;
}
.btn:active { transform: scale(0.97) !important; }
.btn.primary {
  background: linear-gradient(135deg, rgba(255,20,147,0.9), rgba(255,105,180,0.9)) !important;
  border-color: rgba(255, 255, 255, 0.4) !important;
  box-shadow: var(--glow-pink), var(--inset-top) !important;
}
.btn.success {
  background: linear-gradient(135deg, rgba(0,255,136,0.85), rgba(0,212,255,0.7)) !important;
  border-color: rgba(255, 255, 255, 0.5) !important;
  color: #0F0A30 !important;
  text-shadow: none !important;
  box-shadow: var(--glow-green), var(--inset-top) !important;
}
.btn.navigate {
  background: linear-gradient(135deg, rgba(0,200,100,0.85), rgba(0,150,80,0.85)) !important;
  border-color: var(--neon-green) !important;
  box-shadow: var(--glow-green), var(--inset-top) !important;
}

/* ══════════════════════════════════════════════════════════════════
   FORM INPUTS
══════════════════════════════════════════════════════════════════ */
.sheet-inner .form-row label,
.sheet-body .form-row label,
.groq-panel label {
  color: var(--neon-cyan) !important;
  font-family: 'Courier New', monospace !important;
  font-size: 12px !important;
  font-weight: 700 !important;
  letter-spacing: 0.06em !important;
  margin-bottom: 6px !important;
}
.sheet-inner .form-row input,
.sheet-inner .form-row textarea,
.sheet-inner .form-row select,
.sheet-body input,
.sheet-body textarea,
.sheet-body select,
.groq-panel input,
.groq-panel textarea,
.groq-menu-textarea,
.ai-input-row textarea {
  background: rgba(0, 0, 0, 0.30) !important;
  backdrop-filter: blur(8px) !important;
  color: #fff !important;
  border: 1.5px solid var(--glass-border) !important;
  border-radius: 10px !important;
  padding: 11px 14px !important;
  font-family: 'Courier New', monospace !important;
  font-size: 13px !important;
  transition: all 0.2s ease !important;
}
.sheet-inner input::placeholder,
.sheet-body input::placeholder,
.sheet-body textarea::placeholder,
.ai-input-row textarea::placeholder {
  color: rgba(255, 255, 255, 0.45) !important;
}
.sheet-inner input:focus,
.sheet-body input:focus,
.sheet-body textarea:focus,
.ai-input-row textarea:focus,
.groq-menu-textarea:focus {
  outline: none !important;
  border-color: var(--neon-pink) !important;
  box-shadow: 0 0 0 3px rgba(255, 20, 147, 0.20), var(--glow-pink) !important;
}
.form-row { margin-bottom: 14px !important; }

/* ══════════════════════════════════════════════════════════════════
   BOOKING / SHOP / GF CARDS — holographic accent
══════════════════════════════════════════════════════════════════ */
.booking-card,
.shop-card,
.gf-place-card {
  background: var(--glass-bg-strong) !important;
  backdrop-filter: blur(14px) saturate(160%) !important;
  -webkit-backdrop-filter: blur(14px) saturate(160%) !important;
  border: 1.5px solid var(--glass-border) !important;
  border-radius: 14px !important;
  padding: 14px 16px !important;
  margin-bottom: 12px !important;
  box-shadow: var(--inset-top) !important;
  position: relative !important;
}

.booking-card .bc-title,
.shop-card .sc-name,
.gpc-name { color: #fff !important; font-weight: 700 !important; font-size: 14px !important; text-shadow: 0 1px 4px rgba(0,0,0,0.3) !important; }
.booking-card .bc-city,
.shop-card .sc-meta,
.gpc-city,
.shop-card .sc-hours { color: rgba(255, 255, 255, 0.65) !important; font-size: 12px !important; }
.shop-card .sc-rating,
.gpc-rating { color: var(--neon-gold) !important; font-weight: 700 !important; text-shadow: 0 0 10px rgba(255,215,0,0.5) !important; }
.shop-card .sc-notes { color: rgba(255,255,255,0.85) !important; font-style: italic !important; }

.booking-card .bc-icon {
  background: linear-gradient(135deg, var(--neon-pink), var(--violet)) !important;
  box-shadow: var(--glow-pink), var(--inset-top) !important;
  width: 38px !important; height: 38px !important;
  border-radius: 11px !important;
}
.bc-status.confirmed {
  background: rgba(0, 255, 136, 0.20) !important;
  color: var(--neon-green) !important;
  border: 1px solid var(--neon-green) !important;
  box-shadow: var(--glow-green) !important;
}
.bc-status.pending {
  background: rgba(255, 215, 0, 0.20) !important;
  color: var(--neon-gold) !important;
  border: 1px solid var(--neon-gold) !important;
}
.bc-status.none {
  background: rgba(255, 255, 255, 0.08) !important;
  color: rgba(255, 255, 255, 0.6) !important;
  border: 1px solid var(--glass-border) !important;
}

.booking-date-badge,
.item-tag,
.gpc-tag {
  background: linear-gradient(135deg, var(--neon-pink), #FF69B4) !important;
  color: #fff !important;
  border: 1px solid rgba(255, 255, 255, 0.4) !important;
  box-shadow: var(--inset-top) !important;
  font-weight: 700 !important;
}

/* ══════════════════════════════════════════════════════════════════
   AI CHAT — bolle glass
══════════════════════════════════════════════════════════════════ */
.ai-shell { background: transparent !important; padding: 14px !important; }
.ai-welcome {
  background: var(--glass-bg) !important;
  backdrop-filter: blur(14px) !important;
  border: 1.5px solid var(--glass-border-pink) !important;
  border-radius: 16px !important;
  padding: 16px !important;
  box-shadow: var(--inset-top) !important;
}
.ai-welcome-title { color: #fff !important; font-family: 'Comic Sans MS', cursive !important; font-size: 16px !important; text-shadow: 0 0 14px rgba(255,20,147,0.5) !important; }
.ai-welcome-sub { color: rgba(255,255,255,0.75) !important; }

.ai-msg.user {
  background: linear-gradient(135deg, rgba(255,20,147,0.85), rgba(255,105,180,0.85)) !important;
  backdrop-filter: blur(8px) !important;
  border: 1px solid rgba(255, 255, 255, 0.4) !important;
  color: #fff !important;
  border-radius: 16px 16px 4px 16px !important;
  padding: 11px 14px !important;
  box-shadow: var(--glow-pink), var(--inset-top) !important;
  text-shadow: 0 1px 2px rgba(0,0,0,0.3) !important;
}
.ai-msg.ai {
  background: var(--glass-bg-strong) !important;
  backdrop-filter: blur(14px) saturate(150%) !important;
  border: 1.5px solid var(--glass-border) !important;
  color: #fff !important;
  border-radius: 16px 16px 16px 4px !important;
  padding: 11px 14px !important;
  box-shadow: var(--inset-top) !important;
}
.ai-msg.placeholder {
  background: rgba(255, 255, 255, 0.04) !important;
  border: 1.5px dashed var(--glass-border) !important;
  color: rgba(255, 255, 255, 0.7) !important;
}

.ai-send {
  background: linear-gradient(135deg, var(--neon-pink), #FF69B4) !important;
  color: #fff !important;
  border: 1px solid rgba(255,255,255,0.4) !important;
  border-radius: 12px !important;
  font-weight: 700 !important;
  box-shadow: var(--glow-pink), var(--inset-top) !important;
  font-family: 'Comic Sans MS', cursive !important;
}
.ai-quick-chip {
  background: var(--glass-bg-strong) !important;
  backdrop-filter: blur(8px) !important;
  border: 1px solid var(--glass-border) !important;
  color: #fff !important;
  font-weight: 600 !important;
  border-radius: 999px !important;
  padding: 7px 12px !important;
}
.ai-quick-chip:hover {
  background: linear-gradient(135deg, rgba(255,20,147,0.7), rgba(157,78,221,0.7)) !important;
  border-color: rgba(255,255,255,0.4) !important;
  box-shadow: var(--glow-pink) !important;
}
.ai-itinerary-day {
  background: var(--glass-bg) !important;
  backdrop-filter: blur(10px) !important;
  border: 1.5px solid var(--glass-border) !important;
  border-radius: 12px !important;
  padding: 12px 14px !important;
}
.ai-itinerary-day h4 { color: var(--neon-cyan) !important; text-shadow: 0 0 10px rgba(0,212,255,0.5) !important; }
.ai-footer-note { color: rgba(255,255,255,0.65) !important; }

/* ══════════════════════════════════════════════════════════════════
   GROQ / GF analyzer
══════════════════════════════════════════════════════════════════ */
.groq-panel { padding: 18px 20px !important; }
.groq-api-setup {
  background: var(--glass-bg) !important;
  backdrop-filter: blur(10px) !important;
  border: 1.5px solid var(--glass-border) !important;
  border-radius: 12px !important;
  padding: 14px 16px !important;
}
.groq-api-setup p { color: rgba(255,255,255,0.7) !important; }
.groq-analyze-btn {
  background: linear-gradient(135deg, var(--neon-pink), var(--violet)) !important;
  color: #fff !important;
  border: 1px solid rgba(255,255,255,0.4) !important;
  border-radius: 12px !important;
  font-family: 'Comic Sans MS', cursive !important;
  font-weight: 700 !important;
  padding: 13px !important;
  font-size: 14px !important;
  box-shadow: var(--glow-pink), var(--inset-top) !important;
}
.gf-result-card {
  background: var(--glass-bg) !important;
  backdrop-filter: blur(10px) !important;
  border-left: 4px solid currentColor !important;
  border-radius: 12px !important;
  padding: 12px 14px !important;
}
.gf-result-card.safe  { color: var(--neon-green) !important; box-shadow: 0 0 14px rgba(0,255,136,0.15), var(--inset-top) !important; }
.gf-result-card.risk  { color: var(--neon-gold) !important; box-shadow: 0 0 14px rgba(255,215,0,0.15), var(--inset-top) !important; }
.gf-result-card.avoid { color: #FF6B6B !important; box-shadow: 0 0 14px rgba(255,107,107,0.15), var(--inset-top) !important; }
.gf-result-card h4 { color: currentColor !important; }
.gf-result-card ul { color: #fff !important; }
.gf-result-card li { color: rgba(255,255,255,0.9) !important; }

/* GF places */
.gf-places-container { padding: 18px 20px !important; }
.gpc-actions button {
  background: var(--glass-bg-strong) !important;
  backdrop-filter: blur(8px) !important;
  border: 1px solid var(--glass-border) !important;
  color: #fff !important;
  border-radius: 9px !important;
  font-weight: 600 !important;
}
.gf-place-form {
  background: var(--glass-bg) !important;
  backdrop-filter: blur(10px) !important;
  border: 1.5px solid var(--glass-border) !important;
  border-radius: 14px !important;
  padding: 14px 16px !important;
}
.gf-place-form .form-actions button {
  background: linear-gradient(135deg, var(--neon-pink), #FF69B4) !important;
  color: #fff !important;
  border: 1px solid rgba(255,255,255,0.4) !important;
  border-radius: 10px !important;
  font-weight: 700 !important;
  font-family: 'Comic Sans MS', cursive !important;
}
.gf-place-form .form-actions button.secondary {
  background: var(--glass-bg-strong) !important;
  color: #fff !important;
  border: 1.5px solid var(--glass-border) !important;
}
.gf-empty-state { color: rgba(255,255,255,0.6) !important; }
.tag-chip {
  background: linear-gradient(135deg, var(--neon-pink), #FF69B4) !important;
  color: #fff !important;
  border-radius: 6px !important;
  padding: 4px 9px !important;
  font-weight: 700 !important;
}

/* ══════════════════════════════════════════════════════════════════
   DO/DON'T LISTS, INFO CHIPS, MISC
══════════════════════════════════════════════════════════════════ */
.do-list li::before   { color: var(--neon-green) !important; text-shadow: 0 0 8px rgba(0,255,136,0.6) !important; }
.dont-list li::before { color: #FF6B6B !important; text-shadow: 0 0 8px rgba(255,107,107,0.5) !important; }
.do-list li, .dont-list li { color: #fff !important; }

.info-chip {
  background: var(--glass-bg-strong) !important;
  backdrop-filter: blur(8px) !important;
  border: 1px solid var(--glass-border) !important;
  color: #fff !important;
  border-radius: 8px !important;
  padding: 5px 10px !important;
}
.star.on { color: var(--neon-gold) !important; opacity: 1 !important; text-shadow: 0 0 10px rgba(255,215,0,0.7) !important; }

.photo-upload-zone {
  border: 2px dashed var(--glass-border-pink) !important;
  border-radius: 12px !important;
  color: rgba(255,255,255,0.7) !important;
  background: rgba(255, 20, 147, 0.05) !important;
  backdrop-filter: blur(6px) !important;
  padding: 22px !important;
}
.notif-perm-banner {
  background: var(--glass-bg) !important;
  backdrop-filter: blur(12px) !important;
  border: 1.5px solid var(--glass-border-pink) !important;
  border-radius: 12px !important;
  padding: 14px 16px !important;
}
.notif-perm-banner p { color: #fff !important; }

/* ══════════════════════════════════════════════════════════════════
   TOAST + LEAFLET POPUP + CITY LABELS
══════════════════════════════════════════════════════════════════ */
#toast-container {
  background: linear-gradient(135deg, rgba(255,20,147,0.95), rgba(157,78,221,0.95)) !important;
  backdrop-filter: blur(12px) !important;
  border: 1.5px solid rgba(255,255,255,0.4) !important;
  border-radius: 999px !important;
  color: #fff !important;
  font-family: 'Comic Sans MS', cursive !important;
  font-weight: 700 !important;
  padding: 11px 20px !important;
  box-shadow: var(--glow-pink), var(--inset-top) !important;
  text-shadow: 0 1px 2px rgba(0,0,0,0.3) !important;
}

.leaflet-popup-content-wrapper {
  background: var(--glass-bg-dark) !important;
  backdrop-filter: var(--backdrop) !important;
  border: 1.5px solid var(--glass-border-pink) !important;
  border-radius: 12px !important;
  color: #fff !important;
  box-shadow: var(--glow-pink), var(--inset-top) !important;
}
.leaflet-popup-tip { background: rgba(20,15,50,0.85) !important; }
.popup-title { color: #fff !important; font-family: 'Courier New', monospace !important; font-weight: 700 !important; }
.popup-btn {
  background: linear-gradient(135deg, var(--neon-pink), #FF69B4) !important;
  color: #fff !important;
  border: 1px solid rgba(255,255,255,0.4) !important;
  border-radius: 9px !important;
  font-weight: 700 !important;
  font-family: 'Comic Sans MS', cursive !important;
  padding: 9px 14px !important;
  box-shadow: var(--glow-pink), var(--inset-top) !important;
}
.city-label {
  background: rgba(15, 10, 48, 0.80) !important;
  backdrop-filter: blur(10px) !important;
  color: var(--neon-gold) !important;
  border: 1px solid rgba(255, 215, 0, 0.5) !important;
  font-family: 'Courier New', monospace !important;
  font-weight: 700 !important;
  border-radius: 6px !important;
  padding: 3px 8px !important;
  font-size: 11px !important;
  text-shadow: 0 0 6px rgba(255,215,0,0.5) !important;
}

.poi-marker { border: 2px solid #fff !important; box-shadow: 0 2px 8px rgba(0,0,0,0.4) !important; }
.poi-marker.gf { box-shadow: 0 0 0 3px var(--neon-green), 0 2px 8px rgba(0,0,0,0.4) !important; }

/* ══════════════════════════════════════════════════════════════════
   FIX: due colonne POI affiancate dentro le finestre Y2K
══════════════════════════════════════════════════════════════════ */
.y2k-win-body div[style*="font-size:0"] {
  display: flex !important;
  flex-direction: row !important;
  flex-wrap: nowrap !important;
  gap: 12px !important;
  width: 100% !important;
  font-size: 13px !important;
  align-items: stretch !important;
}
.y2k-win-body div[style*="font-size:0"] > div[style*="inline-block"] {
  display: block !important;
  flex: 1 1 0 !important;
  width: auto !important;
  min-width: 0 !important;
  max-width: none !important;
  margin: 0 !important;
  vertical-align: top !important;
  font-size: 13px !important;
}
.y2k-win-body div[style*="font-size:0"] > div[style*="inline-block"] > div {
  padding: 10px !important;
  word-wrap: break-word !important;
  overflow-wrap: anywhere !important;
}

/* ══════════════════════════════════════════════════════════════════
   ANIMAZIONI
══════════════════════════════════════════════════════════════════ */
@keyframes y2kFloatIn {
  from { opacity: 0; transform: translateY(20px) scale(0.96); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
.sheet.open .sheet-inner {
  animation: y2kFloatIn 0.32s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}

/* Low-tier device fallback: meno blur */
@media (prefers-reduced-transparency: reduce) {
  .sheet-inner, nav.bottom, header, .y2k-win {
    backdrop-filter: blur(4px) !important;
    background: rgba(20, 15, 50, 0.92) !important;
  }
}

/* Desktop */
@media (min-width: 768px) {
  .sheet-inner { border-radius: 18px !important; max-width: 480px !important; }
}

/* Print */
@media print {
  body { background: #fff !important; color: #000 !important; }
  header, nav.bottom, #filters { display: none !important; }
  .sheet-inner { box-shadow: none !important; border: 1px solid #ccc !important; }
}

*/
